{
  "name": "knowgap-desktop",
  "version": "0.2.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "app.knowgap.desktop",
    "productName": "KnowGap",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js"],
    "extraResources": [
      { "from": "../frontend/out", "to": "frontend" },
      { "from": "../backend/dist/knowgap", "to": "backend" }
    ],
    "win": { "target": "nsis" }
  }
}
