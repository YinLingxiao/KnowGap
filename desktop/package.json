{
  "name": "knowgap-desktop",
  "version": "0.2.0",
  "description": "KnowGap（知隙）桌面端：本地学习助手",
  "author": "KnowGap",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "app.knowgap.desktop",
    "productName": "KnowGap",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "icon.ico", "icon.png"],
    "extraResources": [
      { "from": "../frontend/out", "to": "frontend" },
      { "from": "../backend/dist/knowgap", "to": "backend" }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    }
  }
}
