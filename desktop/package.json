{
  "name": "knowgap-desktop",
  "version": "0.5.5",
  "description": "KnowGap（知隙）桌面端：本地学习助手",
  "author": "KnowGap",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "app.knowgap.desktop",
    "productName": "KnowGap",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "window-chrome.js", "startup.js", "startup.html", "icon.ico", "icon.png"],
    "extraResources": [
      { "from": "../frontend/out", "to": "frontend" },
      { "from": "../backend/dist/knowgap", "to": "backend" }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KnowGap",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerLanguages": ["zh_CN"],
      "language": "2052",
      "include": "installer.nsh",
      "runAfterFinish": true
    }
  }
}
