# ============================================
# KnowGap 环境变量示例
# 复制为 .env 并填入真实值
# ============================================

# --- 后端 ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me

# --- 数据库 ---
DATABASE_URL=postgresql://user:password@localhost:5432/knowgap

# --- LLM / AI 服务 ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=

# --- 前端 ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
