# Copy to backend/.env (or repository .env). Never commit the filled file.
# Relative paths resolve from backend/, regardless of the shell's directory.
DATABASE_PATH=data/knowgap.sqlite3

# API root INCLUDING provider version prefix, excluding /chat/completions.
# No provider is selected by default. JSON object output must be supported.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=45

# JSON array; only enable the actual local frontend origins.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend public setting only; never put model credentials in NEXT_PUBLIC_*.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# AnySearch web search (optional; blank uses anonymous quota)
ANYSEARCH_API_KEY=
ANYSEARCH_TIMEOUT_SECONDS=20
